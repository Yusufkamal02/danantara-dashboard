        <mxCell id="e-dashboard-user" value="chart &amp;middot; tabel &amp;middot; report" style="endArrow=block;html=1;strokeColor=#4B5262;fontColor=#4B5262;fontSize=10;rounded=0;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="dashboard" target="user">
          <mxGeometry relative="1" as="geometry" />
