        <!-- ===== Edges: DB -> dashboard -> chatbot / user ===== -->
        <mxCell id="e-db-dashboard" value="reads &amp;mdash; status=verified saja" style="endArrow=block;html=1;strokeColor=#4B5262;fontColor=#4B5262;fontSize=10;rounded=0;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="db-outer" target="dashboard">
