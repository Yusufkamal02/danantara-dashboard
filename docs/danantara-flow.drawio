        <mxCell id="e-job3-fin" value="upsert &amp;middot; status=needs_review (default)" style="endArrow=block;html=1;strokeColor=#9C6A17;fontColor=#9C6A17;fontSize=10;rounded=0;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="job-3" target="tbl-fin">
