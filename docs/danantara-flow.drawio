        <mxCell id="tag-needsreview" value="status = needs_review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FBF1DE;strokeColor=#9C6A17;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#9C6A17;" vertex="1" parent="1">
