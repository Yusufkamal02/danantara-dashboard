        <mxCell id="job-2" value="Job 2 &amp;middot; Fundamental&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cron mingguan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF0FC;strokeColor=#3F52C7;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="350" y="140" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="job-3" value="Job 3 &amp;middot; AI-Extraction&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cron mingguan &amp;middot; Claude API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF0FC;strokeColor=#3F52C7;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="640" y="140" width="280" height="64" as="geometry" />
        </mxCell>

        <!-- ===== Database outer + sub-tables ===== -->
        <mxCell id="db-outer" value="SUPABASE &amp;mdash; POSTGRES + AUTH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C7CCD6;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#4B5262;verticalAlign=top;align=left;spacingTop=8;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="920" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tbl-price" value="price_snapshots&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ticker &amp;middot; price &amp;middot; captured_at&lt;br&gt;data lama tidak ditimpa jika fetch gagal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F6F8;strokeColor=#C7CCD6;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="50" y="290" width="260" height="110" as="geometry" />
