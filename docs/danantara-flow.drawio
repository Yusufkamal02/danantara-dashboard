        <mxCell id="tbl-fin" value="financial_reports&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;revenue &amp;middot; net_profit &amp;middot; total_assets &amp;middot; source_url &amp;middot; status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F6F8;strokeColor=#C7CCD6;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="290" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tag-verified" value="status = verified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#E7F6EE;strokeColor=#1F8A5C;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#1F8A5C;" vertex="1" parent="1">
          <mxGeometry x="380" y="352" width="150" height="32" as="geometry" />
