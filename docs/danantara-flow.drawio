        <mxCell id="e-dashboard-chatbot" value="HTTP" style="endArrow=block;html=1;strokeColor=#8A4FBF;fontColor=#8A4FBF;fontSize=10;dashed=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dashboard" target="chatbot">
