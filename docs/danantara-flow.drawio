        <mxCell id="user" value="Viewer Internal Danantara&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;login wajib, tanpa akses eksternal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF0FC;strokeColor=#3F52C7;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="200" y="710" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Edges: sources -> jobs ===== -->
        <mxCell id="e-src-a-job1" value="fetch" style="endArrow=block;html=1;strokeColor=#4B5262;fontColor=#4B5262;fontSize=10;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="src-a" target="job-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-src-b-job2" value="fetch" style="endArrow=block;html=1;strokeColor=#4B5262;fontColor=#4B5262;fontSize=10;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="src-b" target="job-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-src-c-job3" value="fetch" style="endArrow=block;html=1;strokeColor=#4B5262;fontColor=#4B5262;fontSize=10;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="src-c" target="job-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Edges: jobs -> database tables ===== -->
        <mxCell id="e-job1-price" value="upsert" style="endArrow=block;html=1;strokeColor=#4B5262;fontColor=#4B5262;fontSize=10;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="job-1" target="tbl-price">
          <mxGeometry relative="1" as="geometry" />
