        <mxCell id="e-job2-fin" value="upsert &amp;middot; status=verified (auto)" style="endArrow=block;html=1;strokeColor=#1F8A5C;fontColor=#1F8A5C;fontSize=10;rounded=0;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="job-2" target="tbl-fin">
