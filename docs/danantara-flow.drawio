<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0" type="device">
  <diagram id="danantara-flow" name="Alur Sistem Danantara">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Row: external data sources ===== -->
        <mxCell id="src-a" value="API Harga Saham&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3rd-party &amp;middot; GOAPI.io &amp;rarr; Invezgo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF0FC;strokeColor=#3F52C7;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="src-b" value="Sectors.app API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fundamentals terstruktur&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF0FC;strokeColor=#3F52C7;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="src-c" value="Dokumen Resmi&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IDX filing / IR perusahaan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF0FC;strokeColor=#3F52C7;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="640" y="30" width="280" height="64" as="geometry" />
        </mxCell>

        <!-- ===== Row: scheduled jobs (Vercel Cron, our repo) ===== -->
        <mxCell id="job-1" value="Job 1 &amp;middot; Harga Saham&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cron &amp;plusmn;15 min, jam bursa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF0FC;strokeColor=#3F52C7;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#14171C;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="280" height="64" as="geometry" />
